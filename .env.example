DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_strong_random_value
STORAGE_PROVIDER=s3 # or local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mediosk
S3_FORCE_PATH_STYLE=true
# OCR provider: 'ocr_space' | 'mock'
# Set to 'mock' for local development. For production, set to 'ocr_space' and provide OCR_SPACE_API_KEY.
OCR_PROVIDER=ocr_space
LLM_PROVIDER=mock
OCR_API_KEY=
OCR_SPACE_API_KEY=
LLM_API_KEY=
LLM_MODEL=
MAX_UPLOAD_MB=10
